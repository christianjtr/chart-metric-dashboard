{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "legacy"
  ],
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "start": "concurrently \"vue-cli-service serve\" \"nodemon server/app.js\"",
    "server": "nodemon server/app.js",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "test": "npm run test --workspace server"
  },
  "overrides": {
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.5",
    "d3-color": "^3.1.0",
    "decode-uri-component": "^0.5.0",
    "form-data": "^4.0.6",
    "minimatch": "^11.0.1",
    "qs": "^6.16.1",
    "serialize-javascript": "^7.1.3",
    "tmp": "^0.2.6",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1",
    "vue-c3": {
      "c3": "$c3"
    },
    "postcss": "8.5.23"
  }
}
