{
  "sources": [
    {
      "id": "platform-errors",
      "adapter": "ndjson",
      "label": "Fake Platform Errors",
      "path": "server/data/data.ndjson",
      "mapping": {
        "date": "date",
        "series": "typeOfError",
        "dateFormat": "DD-MM-YYYY"
      }
    },
    {
      "id": "external-api",
      "adapter": "rest",
      "label": "External API",
      "url": "https://api.example.com/events",
      "refresh": 300,
      "headers": {
        "Authorization": "env:EXTERNAL_API_KEY"
      },
      "mapping": {
        "date": "items[].createdAt",
        "value": "items[].count",
        "series": "items[].kind"
      }
    }
  ],
  "panels": [
    {
      "title": "Errors over time",
      "source": "platform-errors",
      "metric": "count",
      "chart": "area-step",
      "granularity": "day",
      "groupBy": "typeOfError",
      "section": "Overview"
    },
    {
      "title": "Errors by type per month",
      "source": "platform-errors",
      "metric": "count",
      "chart": "bar",
      "granularity": "month",
      "groupBy": "typeOfError",
      "section": "Overview"
    },
    {
      "title": "Total errors (latest year)",
      "source": "platform-errors",
      "metric": "count",
      "chart": "stat",
      "granularity": "year",
      "reduce": "sum",
      "span": 3,
      "section": "Display demos"
    },
    {
      "title": "Errors in latest month",
      "source": "platform-errors",
      "metric": "count",
      "chart": "stat",
      "granularity": "month",
      "reduce": "sum",
      "span": 3,
      "section": "Display demos"
    },
    {
      "title": "Errors vs 10k budget",
      "source": "platform-errors",
      "metric": "count",
      "chart": "gauge",
      "granularity": "year",
      "reduce": "sum",
      "min": 0,
      "max": 10000,
      "thresholds": [
        { "value": 0, "color": "#73bf69" },
        { "value": 7000, "color": "#f2cc0c" },
        { "value": 9000, "color": "#f2495c" }
      ],
      "span": 3,
      "section": "Display demos"
    },
    {
      "title": "Peak day (2017)",
      "source": "platform-errors",
      "metric": "count",
      "chart": "gauge",
      "granularity": "day",
      "reduce": "max",
      "min": 0,
      "max": 30,
      "thresholds": [
        { "value": 0, "color": "#73bf69" },
        { "value": 15, "color": "#f2cc0c" },
        { "value": 25, "color": "#f2495c" }
      ],
      "span": 3,
      "section": "Display demos"
    }
  ]
}
